spotify_client_id: "<spotify client id>"
spotify_client_secret: "<spotify client secret>"
spotify_username: "<spotify username>"
spotify_playlists:
  - "<playlist name>"

# Optional Home Assistant webhook URL for track move notifications.
# Example: https://your-home-assistant.local/api/webhook/spotify_track_moved
webhook_url: "<optional home assistant webhook URL>"

# Optional path to an executable script called for each track that is
# actually moved or copied. It is invoked as:
#   <script> "<playlist name>" "<spotify track url>"
# Not called during --dry-run (only a preview line is printed instead).
track_hook_script: "<optional path to hook script>"
